# Server API port and local SQLite persistence path
PORT=3001
DATABASE_URL="file:./dev.db"
# Set the same long random value in server and client to enable demo bearer authentication.
APP_API_TOKEN=replace-with-a-long-random-secret
VITE_API_URL=http://localhost:3001/api
VITE_API_TOKEN=replace-with-a-long-random-secret
